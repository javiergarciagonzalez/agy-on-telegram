# Telegram Bot Token obtained from @BotFather (Required)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Comma-separated list of Telegram User IDs allowed to access the bot (Required)
ALLOWED_USER_IDS=123456789,987654321

# Path to the AGY binary (Optional; defaults to looking up `agy` in PATH or ~/.local/bin/agy)
# AGY_BIN=/usr/local/bin/agy

# Working directory where AGY will execute (Optional; defaults to the user's home directory)
# WORKSPACE_DIR=/home/user

# Whisper HTTP transcription endpoint (Optional; defaults to http://127.0.0.1:8765/transcribe)
# WHISPER_ENDPOINT=http://127.0.0.1:8765/transcribe

# Temporary storage directory for received images (Optional; defaults to ./images)
# IMAGE_DIR=/home/user/agy-on-telegram/images
